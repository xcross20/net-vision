{
  "name": "@net-vision/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe:identity": "node --experimental-strip-types --no-warnings scripts/probe-number-identity.ts",
    "probe:cursor": "node --experimental-strip-types --no-warnings scripts/opensea-cursor-probe.ts",
    "index:import": "npx tsx scripts/import-market-index.ts",
    "start:worker": "npx tsx --tsconfig tsconfig.json scripts/run-market-worker.ts"
  },
  "dependencies": {
    "@net-vision/chain-config": "*",
    "@net-vision/opensea-client": "*",
    "@net-vision/taxonomy": "*",
    "@net-vision/transaction-policy": "*",
    "@net-vision/ui": "*",
    "@opensea/sdk": "^12.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "framer-motion": "^13.2.0",
    "next": "^15.1.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5",
    "ws": "^8.21.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
