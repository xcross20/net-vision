# Net Vision web app environment variables.
# Copy to .env.local for development. Set in Railway for deployment.

# --- Server-only secrets (never NEXT_PUBLIC_) ---
# OPENSEA_API_KEY=your_server_side_opensea_key
# ROBINHOOD_RPC_PRIMARY=https://your-rpc-endpoint
# ROBINHOOD_RPC_SECONDARY=https://backup-rpc
# SESSION_SECRET=replace_with_a_long_random_string

# --- Public, non-secret ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=1311
NEXT_PUBLIC_COLLECTION_CONTRACT=0xE5143de9D3CcBc31Ffb4e7Fc66d8320e0E2693D2
NEXT_PUBLIC_OPENSEA_COLLECTION_SLUG=button-presser

# --- Feature flags ---
# Trading is OFF by default. The transaction-policy adversarial suite
# must pass before any live trade preparation is enabled.
NEXT_PUBLIC_TRADING_ENABLED=false
